  "groups": {
    "assistant": {
      "display_name": "AI Assistant",
      "description": "Student study chat assistant.",
      "icon": "fa-comments",
      "order": 10
    },
    "explanation": {
      "display_name": "Question Explanation",
      "description": "Step-by-step explanations of wrongly answered questions.",
      "icon": "fa-lightbulb",
      "order": 20
    },
    "question_generation": {
      "display_name": "Question Generation",
      "description": "Admin AI Command Centre question extraction and generation.",
      "icon": "fa-robot",
      "order": 30
    }
  },
  "features": {
    "assistant_chat": {
      "group": "assistant",
      "display_name": "Assistant Chat Replies",
      "description": "Answers a student's message in the AI Assistant chat.",
      "requires": [
        "text"
      ],
      "used_by": "app/services/ai_service.py · get_groq_response"
    },
    "assistant_title": {
      "group": "assistant",
      "display_name": "Chat Title Generation",
      "description": "Writes a short conversation title from the student's first message.",
      "requires": [
        "text"
      ],
      "used_by": "app/services/ai_service.py · generate_title_via_model"
    },
    "explanation_text": {
      "group": "explanation",
      "display_name": "Explanation (text questions)",
      "description": "Explains questions that have no image.",
      "requires": [
        "text"
      ],
      "used_by": "app/services/explanation_service.py · generate_explanation"
    },
    "explanation_vision": {
      "group": "explanation",
      "display_name": "Explanation (image questions)",
      "description": "Explains questions that include a diagram or image.",
      "requires": [
        "vision"
      ],
      "used_by": "app/services/explanation_service.py · generate_explanation"
    },
    "question_generation_text": {
      "group": "question_generation",
      "display_name": "Generation from text",
      "description": "Direct extraction from text PDFs, concept mining, and pure topic generation.",
      "requires": [
        "text"
      ],
      "used_by": "app/services/ai_question_generator.py · AIQuestionGenerator.generate_text"
    },
    "question_generation_vision": {
      "group": "question_generation",
      "display_name": "Generation from scanned PDFs",
      "description": "Reads image-based PDFs directly (vision) when a PDF has no usable text layer.",
      "requires": [
        "vision",
        "pdf"
      ],
      "used_by": "app/services/ai_question_generator.py · AIQuestionGenerator._generate_vision_*"
    }
  },
  "assignments": {
    "assistant_chat": {
      "model": "gemini/gemma-4-26b-a4b-it",
      "credential_env": {
        "gemini": "TEXT_MODEL_ASSISTANT_API_KEY"
      }
    },
    "assistant_title": {
      "model": "gemini/gemma-4-26b-a4b-it",
      "credential_env": {
        "gemini": "TEXT_MODEL_ASSISTANT_API_KEY"
      }
    },
    "explanation_text": {
      "model": "groq/gpt-oss-120b",
      "credential_env": {
        "groq": "TEXT_MODEL_EXPLANATION_API_KEY"
      }
    },
    "explanation_vision": {
      "model": "gemini/gemma-4-26b-a4b-it",
      "credential_env": {
        "gemini": "VISION_MODEL_EXPLANATION_API_KEY"
      }
    },
    "question_generation_text": {
      "model": "gemini/gemini-2.5-flash",
      "credential_env": {
        "gemini": "TEXT_MODEL_QUESTIONGEN_API_KEY"
      }
    },
    "question_generation_vision": {
      "model": "gemini/gemini-2.5-flash",
      "credential_env": {
        "gemini": "VISION_MODEL_QUESTIONGEN_API_KEY"
      }
    }
  }
