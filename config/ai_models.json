{
  "_about": "SmartAIExam AI registry (configuration only). How to edit it: config/AI_MODELS.md",
  "schema_version": 3,
  "capabilities": {
    "text": {
      "label": "Text",
      "icon": "fa-font",
      "input": [
        "text"
      ],
      "output": [
        "text"
      ]
    },
    "vision": {
      "label": "Vision",
      "icon": "fa-eye",
      "input": [
        "image"
      ]
    },
    "pdf": {
      "label": "PDF / Document",
      "icon": "fa-file-pdf",
      "input": [
        "pdf"
      ]
    },
    "structured_output": {
      "label": "Structured Output",
      "icon": "fa-code",
      "output": [
        "json"
      ]
    },
    "embedding": {
      "label": "Embeddings",
      "icon": "fa-project-diagram",
      "output": [
        "vector"
      ]
    }
  },
  "providers": {
    "groq": {
      "display_name": "Groq",
      "protocol": "openai_compatible",
      "enabled": true,
      "api": {
        "base_url": "https://api.groq.com/openai/v1",
        "endpoint": "/chat/completions",
        "auth": {
          "header": "Authorization",
          "scheme": "Bearer"
        },
        "key_env": "GROQ_API_KEY"
      },
      "ui": {
        "logo": "/static/ai/providers/groq.svg",
        "icon": null,
        "color": "#f55036",
        "website": "https://groq.com"
      }
    },
    "gemini": {
      "display_name": "Google Gemini",
      "protocol": "gemini",
      "enabled": true,
      "api": {
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "upload_url": "https://generativelanguage.googleapis.com/upload/v1beta/files",
        "auth": {
          "header": "x-goog-api-key",
          "scheme": ""
        },
        "key_env": "GEMINI_API_KEY"
      },
      "ui": {
        "logo": "/static/ai/providers/gemini.svg",
        "icon": null,
        "color": "#4285f4",
        "website": "https://ai.google.dev"
      }
    }
  },
